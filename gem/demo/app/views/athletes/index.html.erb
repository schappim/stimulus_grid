<% content_for :title, "Athletes — stimulus_grid_rails demo" %>

<header class="page">
  <h1>Athletes</h1>
  <p class="lede">
    Edit any cell. Changes commit on <kbd>Enter</kbd> / blur, fly through a
    <code>PATCH /grids/athletes/:id/cells/:column</code> with an optimistic id,
    and broadcast to every connected tab via Turbo Stream over Action Cable.
    Try opening this page in two browser windows side-by-side and edit in one
    — the other updates within ~50 ms.
  </p>
  <ul class="features">
    <li><strong>Server-side column registry</strong> (RAILS.md §7): see <code>app/grids/athlete_grid.rb</code></li>
    <li><strong>Optimistic updates</strong> with reconcile (§4): blue pulse during commit, green flash on confirm, red on revert</li>
    <li><strong>Computed cascade</strong> (§12): edit gold/silver/bronze and watch <em>total</em> update in the same broadcast</li>
    <li><strong>Version-checked concurrency</strong> (§13): the <em>age</em> column carries <code>lock_version</code></li>
    <li><strong>Add / remove rows</strong> (§14/§15): the toolbar adds; the × on each row (or "Delete selected") removes — live in every tab</li>
    <li><strong>Server-side global search + filtering</strong> (§21): the search box and per-column filters query the DB via the column registry (<code>GET /grids/athletes/rows</code>) and swap the dataset</li>
    <li><strong>Custom cells</strong>: <em>Medals</em> is a read-only renderer; <em>Sport</em> is an <strong>editable</strong> custom cell — a pill for display + a custom <code>&lt;select&gt;</code> editor (double-click it)</li>
    <li><strong>Bulk paste</strong> (§9): click an editable cell, then paste tab/newline-separated data (e.g. from a spreadsheet) — it fills the range and saves via <code>POST /bulk</code></li>
    <li><strong>Cross-tab live sync</strong> via <code>turbo_stream_from "athletes"</code></li>
    <li><strong>Server validation</strong>: try setting age to 999 — server rejects, cell reverts with a tooltip</li>
  </ul>
  <p><a href="/big_rows">→ See the <strong>server-side row model</strong> demo (50,000 rows, windowed fetch)</a></p>
</header>

<%# Per-row delete button cloned by the _actions column's cell renderer. %>
<template id="sgr-row-actions">
  <button type="button" class="sgr-del" data-sgr-action="delete-row" title="Delete row">×</button>
</template>

<%# Custom cell: medal badges bound to the row's gold/silver/bronze values. %>
<template id="sgr-medals">
  <span class="medals">
    <span class="medal gold"   data-bind="gold"   title="Gold"></span>
    <span class="medal silver" data-bind="silver" title="Silver"></span>
    <span class="medal bronze" data-bind="bronze" title="Bronze"></span>
  </span>
</template>

<%# Editable custom cell: a pill for display, a <select> for editing. %>
<template id="sgr-sport">
  <span class="sport-pill" data-bind="sport" data-bind-attr="data-sport"></span>
</template>
<template id="sgr-sport-editor">
  <select class="sport-editor" data-editor-input>
    <% AthleteGrid.columns_registry[:sport].enum_values.each do |s| %>
      <option value="<%= s %>"><%= s %></option>
    <% end %>
  </select>
</template>

<div class="searchbar" data-grid-id="athletes-grid">
  <input type="search" id="global-search" autocomplete="off"
         placeholder="🔎  Search athletes — name, country, sport (server-side)…" />
  <button type="button" id="clear-filters">Clear</button>
</div>

<div class="toolbar" data-grid-id="athletes-grid">
  <button type="button" id="add-row">+ Add athlete</button>
  <button type="button" id="delete-selected">Delete selected</button>
  <span class="filters">
    <input type="search" class="col-filter" data-col="country" data-op="contains" placeholder="country contains…" autocomplete="off" />
    <input type="search" class="col-filter" data-col="sport"   data-op="contains" placeholder="sport contains…" autocomplete="off" />
    <input type="number" class="col-filter" data-col="gold"    data-op="greaterThanOrEqual" placeholder="min gold" />
  </span>
  <span class="stat" id="stat">…</span>
</div>

<%= render partial: "stimulus_grid_rails/grids/grid",
           locals: { grid: @grid, rows: @athletes, row_selection: "multiple", page_size: 25, row_gutter: true } %>

<footer class="page-foot">
  <small>
    Total computed live as you edit medal counts. Backed by Action Cable;
    open <code>/cable</code> in two tabs to see the WebSocket frames.
  </small>
</footer>

<script>
  // Toolbar → grid: dispatch events the grid-sync controller listens for. The
  // toolbar lives outside the grid element, so we target the grid by id rather
  // than relying on Stimulus action scope.
  (function () {
    const gridEl = document.getElementById("athletes-grid");
    const stat = document.getElementById("stat");
    const grandTotal = <%= @athletes.size %>;

    document.getElementById("add-row").addEventListener("click", () => {
      gridEl.dispatchEvent(new CustomEvent("grid-sync:add-row"));
    });
    document.getElementById("delete-selected").addEventListener("click", () => {
      gridEl.dispatchEvent(new CustomEvent("grid-sync:delete-selected"));
    });

    // Global search → server-side query.
    document.getElementById("global-search").addEventListener("input", (e) => {
      gridEl.dispatchEvent(new CustomEvent("grid-sync:search", { detail: { q: e.target.value } }));
    });

    // Per-column filters → server-side query. Each input declares its column +
    // operator; an empty value clears that column's filter.
    document.querySelectorAll(".col-filter").forEach((inp) => {
      inp.addEventListener("input", () => {
        const value = inp.value.trim();
        const criteria = value === "" ? null : { type: inp.dataset.op, value };
        gridEl.dispatchEvent(new CustomEvent("grid-sync:filter", {
          detail: { column: inp.dataset.col, criteria },
        }));
      });
    });

    // Clear everything.
    document.getElementById("clear-filters").addEventListener("click", () => {
      document.getElementById("global-search").value = "";
      document.querySelectorAll(".col-filter").forEach((i) => { i.value = ""; });
      gridEl.dispatchEvent(new CustomEvent("grid-sync:clear-filters"));
    });

    // Dim zero-count medal badges after each render (custom-cell polish).
    function dimZeros() {
      requestAnimationFrame(() => {
        gridEl.querySelectorAll(".medal").forEach((m) => {
          m.dataset.zero = m.textContent.trim() === "0" ? "true" : "";
        });
      });
    }

    let lastServerTotal = null;
    function refreshStat() {
      const api = gridEl.gridApi;
      if (!api) return;
      const shown = api.getRowData().length;
      const selected = api.getSelectedRowIds ? api.getSelectedRowIds().length : 0;
      let base = lastServerTotal == null || lastServerTotal === shown
        ? `${shown} rows`
        : `${shown} of ${grandTotal} rows (filtered)`;
      stat.textContent = base + (selected ? ` · ${selected} selected` : "");
    }
    gridEl.addEventListener("grid-sync:rows-fetched", (e) => {
      lastServerTotal = e.detail.total;
      refreshStat();
    });
    ["grid:ready", "grid:rowDataChanged", "grid:selectionChanged"].forEach((ev) =>
      gridEl.addEventListener(ev, () => { refreshStat(); dimZeros(); }));
    requestAnimationFrame(() => { refreshStat(); dimZeros(); });
  })();
</script>

<style>
  body {
    font-family: system-ui, -apple-system, sans-serif;
    max-width: 1200px;
    margin: 30px auto;
    padding: 0 20px;
    color: #1f2937;
    line-height: 1.5;
  }
  header.page h1 { margin-bottom: 4px; }
  .lede { color: #4b5563; margin-top: 0; }
  .features {
    background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px;
    padding: 10px 28px; font-size: 13px; color: #374151;
  }
  .features li { margin: 4px 0; }
  .features strong { color: #111827; }
  /* --- Search box --- */
  .searchbar {
    display: flex; align-items: center; gap: 8px; margin-top: 16px;
  }
  .searchbar #global-search {
    flex: 1;
    appearance: none;
    background: #fff;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 10px 14px;
    font: inherit;
    font-size: 15px;
    color: #111827;
    box-shadow: 0 1px 2px rgba(0,0,0,0.04);
    transition: border-color .12s ease, box-shadow .12s ease;
  }
  .searchbar #global-search::placeholder { color: #9ca3af; }
  .searchbar #global-search:focus {
    outline: none;
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
  }
  .searchbar #clear-filters {
    background: #fff; border: 1px solid #d1d5db; border-radius: 8px;
    padding: 9px 16px; font: inherit; cursor: pointer; color: #374151;
  }
  .searchbar #clear-filters:hover { background: #f3f4f6; }

  /* --- Toolbar (actions + per-column filters) --- */
  .toolbar {
    display: flex; align-items: center; gap: 8px; margin-top: 10px; flex-wrap: wrap;
  }
  .toolbar button {
    background: #fff; border: 1px solid #d1d5db; border-radius: 5px;
    padding: 6px 12px; font: inherit; cursor: pointer;
  }
  .toolbar button:hover { background: #f3f4f6; }
  .toolbar #add-row { border-color: #2563eb; color: #1d4ed8; }
  .toolbar #delete-selected { border-color: #fca5a5; color: #dc2626; }
  .toolbar .filters { display: flex; gap: 6px; align-items: center; }
  .toolbar .col-filter {
    background: #fff; border: 1px solid #d1d5db; border-radius: 5px;
    padding: 5px 9px; font: inherit; font-size: 13px; width: 150px;
  }
  .toolbar .col-filter[type="number"] { width: 90px; }
  .toolbar .col-filter:focus {
    outline: none; border-color: #2563eb; box-shadow: 0 0 0 2px rgba(37,99,235,.12);
  }
  .toolbar .stat { margin-left: auto; color: #6b7280; font-size: 13px; white-space: nowrap; }
  .sgr-del {
    background: transparent; border: 1px solid #fca5a5; color: #dc2626;
    border-radius: 4px; padding: 0 8px; font-size: 15px; line-height: 20px;
    cursor: pointer;
  }
  .sgr-del:hover { background: #fee2e2; }

  /* --- Custom cell: medal badges --- */
  .medals { display: inline-flex; gap: 3px; align-items: center; }
  .medal {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 22px; height: 18px; border-radius: 9px;
    font-size: 11px; font-weight: 600;
  }
  .medal.gold   { background: #fef3c7; color: #92400e; }
  .medal.silver { background: #e5e7eb; color: #374151; }
  .medal.bronze { background: #fce7d6; color: #9a3412; }
  .medal[data-zero="true"] { opacity: 0.25; }

  /* --- Editable custom cell: sport pill + select editor --- */
  .sport-pill {
    display: inline-block; padding: 1px 9px; border-radius: 999px;
    font-size: 12px; font-weight: 600; background: #eef2ff; color: #3730a3;
  }
  .sport-pill[data-sport="Swimming"]   { background: #e0f2fe; color: #075985; }
  .sport-pill[data-sport="Cycling"]    { background: #dcfce7; color: #166534; }
  .sport-pill[data-sport="Gymnastics"] { background: #fae8ff; color: #86198f; }
  .sport-pill[data-sport="Athletics"]  { background: #fef9c3; color: #854d0e; }
  .sport-pill[data-sport="Boxing"]     { background: #ffe4e6; color: #9f1239; }
  .sport-editor {
    width: 100%; box-sizing: border-box; font: inherit; padding: 2px 4px;
    border: 1px solid #2563eb; border-radius: 4px;
  }

  .sgr-panel { height: 600px; margin-top: 10px; }
  kbd {
    background: #f3f4f6; border: 1px solid #d1d5db; border-bottom-width: 2px;
    border-radius: 3px; padding: 1px 5px; font-family: ui-monospace, monospace;
    font-size: .85em;
  }
  code {
    background: #f3f4f6; padding: 1px 5px; border-radius: 3px;
    font-family: ui-monospace, monospace; font-size: .9em;
  }
  .page-foot { margin-top: 20px; color: #6b7280; font-size: 13px; }
</style>
